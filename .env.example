# ----- CareCircle environment variables. Copy to .env.local for local use.

# Secret used to sign session cookies and email action links (required
# in production; at least 32 random characters).
SESSION_SECRET=

# Public address of the deployed app, used inside reminder emails.
APP_BASE_URL=http://localhost:3000

# Storage: "memory" for local work and tests, "firestore" on Cloud Run.
STORE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=

# Gemini API key for prescription reading and summaries (optional; the
# app falls back to manual entry and rule-based summaries without it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email delivery over SMTP (optional; without it emails are recorded in
# the notification log instead of being sent).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Shared secret that Cloud Scheduler sends to /api/cron/tick.
CRON_SECRET=
